{
  "name": "carpantier-consulting",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run check:all && pnpm run build",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:blog": "node scripts/blog-audit.mjs",
    "check:redirects": "node scripts/check-blog-redirects.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:duplication": "node scripts/check-content-duplication.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:directories": "node scripts/check-directories.mjs",
    "check:all": "pnpm run check:compliance && pnpm run check:blog && pnpm run check:redirects && pnpm run check:links && pnpm run check:sitemap && pnpm run check:duplication && pnpm run check:pricing && pnpm run check:directories && pnpm run check:forbidden",
    "check:forbidden": "node scripts/check-forbidden-targets.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:predeploy": "pnpm run check:live && pnpm run check:ssr && pnpm run check:seo && pnpm run check:performance"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.469.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.6",
    "puppeteer": "^24.36.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
