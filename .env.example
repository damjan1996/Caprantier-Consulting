# Analytics — laedt erst nach der Analyse-Einwilligung.
# Ohne Wert wird gtag.js nie geladen.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Marketing — laedt erst nach der Marketing-Einwilligung.
# Ohne Wert wird das Brevo-Tracking nie geladen.
NEXT_PUBLIC_BREVO_CLIENT_KEY=your-brevo-client-key

# Datenbank (Chat-Sitzungen). Wird von prisma/schema.prisma gelesen.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# KI-Chatbot. Ohne Wert antwortet /api/chat mit einem Fehler.
ANTHROPIC_API_KEY=sk-ant-...

# Signiert Chat-Sitzungskennungen. Ohne diesen Wert gilt je Serverprozess ein
# Zufallsschluessel und laufende Chats brechen bei jedem Neustart ab.
# Erzeugen mit: openssl rand -hex 32
CHAT_SESSION_SECRET=

# Benachrichtigungen fuer Kontaktformular und Chat-Leads. Ohne Wert schlaegt
# der Versand fehl und das Kontaktformular meldet das dem Absender.
BREVO_API_KEY=

# Schuetzt /api/admin/leads. Ohne Wert antwortet der Endpunkt mit 404.
ADMIN_API_KEY=

# Schuetzt /api/cron/cleanup-chats. Ohne Wert laeuft die Loeschfrist nicht
# und die in der Datenschutzerklaerung zugesagte Loeschung findet nicht statt.
CRON_SECRET=

# Die Calendly-URL steht bewusst im Code (src/components/ui/CalendlyBookingModal.tsx)
# und nicht hier: sie ist keine Umgebungskonfiguration, sondern Teil des Angebots.
